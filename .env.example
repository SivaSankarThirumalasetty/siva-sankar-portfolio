# All variables are optional. Copy to .env and fill in what you need.

# Public URL of the deployed site, e.g. https://sivasankar.pages.dev
# Used for sitemap.xml, robots.txt Sitemap line and canonical/OG URLs.
VITE_SITE_URL=

# Override asset base path. Default './' works for GitHub Pages and Cloudflare Pages.
VITE_BASE_PATH=

# Formspree form ID (the part after https://formspree.io/f/). Public by design — not a secret.
# When empty, the contact form opens the visitor's email app instead of claiming to send.
VITE_FORMSPREE_ID=
